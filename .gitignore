# 临时文件
*.tmp
*.temp
~$*

# 分镜脚本输出中的临时/中间版本
03-分镜脚本输出/*-序列*.md
03-分镜脚本输出/*-part*.md

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 剧本素材和参考资料（如有隐私内容）
04-剧本素材/*
!04-剧本素材/.gitkeep
05-参考资料/*
!05-参考资料/.gitkeep

# Generated visual assets are large; keep prompt knowledge in git by default.
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.mov

# Local repair/install scripts are machine-specific.
*.ps1
